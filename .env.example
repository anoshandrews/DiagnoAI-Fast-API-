# Groq Cloud API (LLM & Whisper Audio)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Clinician Admin Authentication Key
CLINICIAN_SECRET_KEY=clinician-secret-key-123

# Database: Supabase PostgreSQL (Set for persistent cloud storage; leave empty for local development)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?sslmode=require

# CORS Configuration
ALLOW_ORIGINS=*
